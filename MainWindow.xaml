<Window x:Class="WebView2CpuRepro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebView2 CPU repro"
        Width="760"
        Height="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock x:Name="_environment" DockPanel.Dock="Top" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="CPU of this process: " FontSize="20" />
            <TextBlock x:Name="_cpu" Text="-" FontSize="20" FontWeight="Bold" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Open a test window (one at a time, close it before the next one):" Margin="0,0,0,4" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="Plain WPF" Tag="WpfOnly" Click="OnOpenClick" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="WebView2 (HwndHost)" Tag="WebView2Classic" Click="OnOpenClick" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="WebView2CompositionControl" Tag="WebView2Composition" Click="OnOpenClick" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="BlazorWebView" Tag="BlazorWebView" Click="OnOpenClick" Padding="8,4" />
        </WrapPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="_runAllButton" Content="Measure all (auto, ~4 min)" Click="OnRunAllClick" Padding="8,4" Margin="0,0,8,0" FontWeight="Bold" />
            <Button x:Name="_measureButton" Content="Measure 30 s" Click="OnMeasureClick" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="Copy results" Click="OnCopyClick" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="Open results folder" Click="OnOpenFolderClick" Padding="8,4" />
        </WrapPanel>

        <TextBox x:Name="_results" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
